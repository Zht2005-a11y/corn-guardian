.profile-card { display: flex; align-items: center; gap: 24rpx; }
.p-info { flex: 1; min-width: 0; }
.p-action {
  flex: none;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #0BA77B;
  border: 2rpx solid rgba(11, 167, 123, 0.35);
  line-height: 1.3;
}
.avatar {
  width: 110rpx; height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #19C995, #079B76);
  color: #fff;
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.p-name { font-size: 32rpx; font-weight: 600; }
.p-sub { font-size: 22rpx; color: #8C999C; margin-top: 6rpx; }

.stat-row { display: flex; justify-content: space-around; margin-top: 20rpx; }
.stat-item { display: flex; flex-direction: column; align-items: center; }
.stat-item .v { font-size: 36rpx; font-weight: 600; color: #202B2D; }
.stat-item .k { font-size: 22rpx; color: #8C999C; margin-top: 6rpx; }

.menu-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #E9EFF0;
  font-size: 28rpx;
  color: #202B2D;
}
.menu-item:last-child { border-bottom: none; }
.menu-item image:first-child { width: 36rpx; height: 36rpx; }
.menu-item .arrow { width: 28rpx; height: 28rpx; margin-left: auto; }

.about {
  text-align: center;
  font-size: 20rpx;
  color: #8C999C;
  line-height: 1.8;
  padding: 20rpx 0 60rpx;
}
