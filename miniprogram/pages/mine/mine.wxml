<view class="page-body">
  <!-- 用户卡 -->
  <view class="card profile-card">
    <view class="avatar">{{initial}}</view>
    <view class="p-info">
      <view class="p-name">{{user.display_name || user.username || '种植户用户'}}</view>
      <view class="p-sub">{{loggedIn ? ('账号：' + user.username + ' · 已登录') : '未登录 · 部分接口可能无法访问'}}</view>
    </view>
    <view class="p-action" bindtap="goLogin">{{loggedIn ? '切换' : '登录'}}</view>
  </view>

  <!-- 统计 -->
  <view class="card">
    <view class="card-title">诊断统计</view>
    <view class="stat-row">
      <view class="stat-item">
        <text class="v">{{stats.total}}</text>
        <text class="k">累计识别</text>
      </view>
      <view class="stat-item">
        <text class="v">{{stats.today}}</text>
        <text class="k">今日识别</text>
      </view>
      <view class="stat-item">
        <text class="v">{{online ? '在线' : '离线'}}</text>
        <text class="k">服务状态</text>
      </view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="goMonitor">
      <image src="{{icons.chart}}" mode="aspectFit" />
      <text>田间监测</text>
      <image class="arrow" src="{{icons.arrow}}" mode="aspectFit" />
    </view>
    <view class="menu-item" bindtap="goHistory">
      <image src="{{icons.history}}" mode="aspectFit" />
      <text>识别历史</text>
      <image class="arrow" src="{{icons.arrow}}" mode="aspectFit" />
    </view>
    <view wx:if="{{loggedIn}}" class="menu-item" bindtap="doLogout">
      <image src="{{icons.user}}" mode="aspectFit" />
      <text>退出登录</text>
      <image class="arrow" src="{{icons.arrow}}" mode="aspectFit" />
    </view>
  </view>

  <view class="about">玉米叶部病害智能诊断与无人机飞防决策系统 · 小程序端 v1.0<br />模型：ResNet50-CBAM + Grad-CAM</view>
</view>
