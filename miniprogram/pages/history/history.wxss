.filter-scroll { white-space: nowrap; margin-bottom: 22rpx; }
.filter-row { display: inline-flex; gap: 16rpx; }
.filter-chip {
  background: #fff;
  color: #8C999C;
  font-size: 26rpx;
  border-radius: 999rpx;
  padding: 12rpx 32rpx;
  border: 1rpx solid #E9EFF0;
}
.filter-chip.active {
  background: #0BA77B;
  color: #fff;
  border-color: #0BA77B;
}

.history-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx;
}
.h-thumb { width: 110rpx; height: 110rpx; border-radius: 16rpx; background: #F4F4F4; flex-shrink: 0; }
.h-info { flex: 1; min-width: 0; }
.h-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #202B2D;
}
.h-meta { font-size: 22rpx; color: #8C999C; margin-top: 6rpx; }
.h-rate { color: #FF984F; }
.h-actions { display: flex; flex-direction: column; align-items: center; gap: 20rpx; }
.h-arrow { width: 30rpx; height: 30rpx; }
.h-del { width: 34rpx; height: 34rpx; }

.empty-card { display: flex; flex-direction: column; align-items: center; padding: 70rpx 40rpx; }
.empty-icon { width: 96rpx; height: 96rpx; opacity: 0.5; }
.empty-btn { width: 300rpx; margin-top: 8rpx; }

.load-more {
  text-align: center;
  color: #0BA77B;
  font-size: 26rpx;
  padding: 20rpx 0;
}
.clear-row { text-align: center; padding: 24rpx 0 60rpx; }
.clear-btn { color: #F16B5D; font-size: 26rpx; }
