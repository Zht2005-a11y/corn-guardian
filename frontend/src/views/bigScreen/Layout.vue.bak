                <div v-if="msg.searchQuery" class="tool-call-banner">
                  <span class="tool-icon">🌐</span>
                  <span>已调用 web_search 检索：「<strong>{{ msg.searchQuery }}</strong>」</span>
                </div>
                <div class="msg-text">
                  <span v-html="renderFormattedText(msg.text)"></span>
                  <span v-if="msg.isStreaming" class="streaming-cursor"></span>
                </div>
                <div v-if="msg.role === 'ai'" class="msg-meta-row">
                  <span class="msg-tag">
                    <template v-if="msg.searchQuery">Agnes + WebSearch</template>
                    <template v-else>Agnes-3.0-Flash</template>
                  </span>
                </div>
              </div>
            </div>

            <!-- Typing indicator (在未开始吐字时展示，包括联网搜索状态) -->
            <div v-if="aiTyping && !isAiStreaming" class="msg-row ai">
              <div class="msg-avatar">🌽</div>
              <div class="msg-bubble ai typing-bubble">
                <span class="typing-dot"></span>
                <span class="typing-dot"></span>
                <span class="typing-dot"></span>
                <span class="typing-text">{{ toolStatus || 'Agnes-3.0-Flash 正在深入分析玉米病理知识...' }}</span>
              </div>
            </div>
          </div>

          <!-- Input bar (Send button wrapped with React Bits Magnet) -->
          <div class="chat-input-dock">
