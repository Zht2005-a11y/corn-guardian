                        width: box.w + '%',
                        height: box.h + '%',
                        borderColor: currentSample.color
                      }"
                    >
                      <span class="tech-bbox-label" :style="{ background: currentSample.color }">
                        {{ box.label }} · 置信度 {{ box.conf }}
                      </span>
                      <span class="corner lt" :style="{ borderColor: currentSample.color }"></span>
                      <span class="corner rt" :style="{ borderColor: currentSample.color }"></span>
                      <span class="corner lb" :style="{ borderColor: currentSample.color }"></span>
                      <span class="corner rb" :style="{ borderColor: currentSample.color }"></span>
                    </div>
