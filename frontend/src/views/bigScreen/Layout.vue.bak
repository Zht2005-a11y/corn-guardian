            @dragleave.prevent="isDragging = false"
            @drop.prevent="onDrop"
            @click="!previewUrl && $refs.fileInput.click()"
          >
            <!-- Scan laser beam effect during inference -->
            <div v-if="isDetecting" class="scanner-laser"></div>

            <!-- Empty state -->
            <template v-if="!previewUrl">
              <div class="dz-inner-content">
                <Magnet :padding="50" :magnetStrength="2">
                  <div class="dz-icon-wrapper">
                    <svg class="dz-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                      <path stroke-linecap="round" stroke-linejoin="round"
