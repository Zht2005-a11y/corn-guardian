              <DecryptedText :text="currentSample.diseaseName" :speed="25" animateOn="view" />
            </span>
          </div>

          <!-- Metrics 4-grid (Integrated with React Bits CountUp) -->
          <div class="metrics-grid">
            <div class="metric">
