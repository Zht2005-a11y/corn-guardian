            </div>
            <div class="metric">
              <span class="metric-key">大田侵染与发病程度</span>
              <span class="metric-val warn">{{ currentSample.severity }}</span>
              <span class="metric-sub">
                叶面积受损率：
                <CountUp :to="currentSample.damageRate" :from="0" :decimals="1" />%
              </span>
            </div>
            <div class="metric">
              <span class="metric-key">AI 综合识别置信度</span>
              <span class="metric-val success">
                <CountUp :to="currentSample.confidence" :from="60" :decimals="1" />%
              </span>
              <span class="metric-sub">抗噪稳健性指数：96.8分</span>
            </div>
            <div class="metric">
              <span class="metric-key">大田气象诱发风险</span>
              <span class="metric-val danger">高发风险期 (RH 84.2%)</span>
              <span class="metric-sub">推荐飞防作业时段：今日傍晚</span>
            </div>
          </div>

          <!-- Prescription Box -->
          <div class="prescription-box">
            <div class="prescription-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="p-icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25Z"/>
              </svg>
