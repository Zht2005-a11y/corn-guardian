              </div>
            </template>

            <!-- Preview state with React Bits TiltedCard 3D Hover & Glare Effect -->
            <template v-else>
              <TiltedCard :maxTilt="8" :scaleOnHover="1.01">
                <div class="preview-img-container">
                  <img :src="showHeatmap && currentSample?.gradcam_base64 ? currentSample.gradcam_base64 : previewUrl" class="preview-img" alt="玉米叶片" />

                  <!-- Bounding boxes overlay if detected -->
                  <div v-if="isDetected && currentSample && !showHeatmap" class="overlay-boxes">
                    <div
