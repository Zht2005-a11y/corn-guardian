                </span>
                <span class="env-key">叶面冠层温度</span>
              </div>
            </div>
            <div class="env-item warn">
              <span class="env-icon">💧</span>
              <div class="env-info">
                <span class="env-val warn">
                  <CountUp :to="84.2" :from="50" :decimals="1" />
                  <span class="env-unit">%</span>
                </span>
                <span class="env-key">空气相对湿度 (超警戒)</span>
              </div>
            </div>
            <div class="env-item">
              <span class="env-icon">☀️</span>
              <div class="env-info">
                <span class="env-val">
                  <CountUp :to="68.5" :from="30" :decimals="1" />
                  <span class="env-unit">kLux</span>
                </span>
                <span class="env-key">光合有效辐射 (PAR)</span>
              </div>
            </div>
            <div class="env-item warn">
              <span class="env-icon">🌫️</span>
              <div class="env-info">
                <span class="env-val warn">
                  <CountUp :to="142" :from="0" :decimals="0" />
                  <span class="env-unit">个/m³</span>
                </span>
                <span class="env-key">病原孢子扩散密度</span>
              </div>
            </div>
          </div>

          <!-- 24h Trend Chart -->
          <div class="trend-chart-box">
            <div class="chart-sub-head">
              <span>24小时叶面微湿度与孢子萌发诱发曲线</span>
              <span class="chart-alert-tag">警戒线 80% RH</span>
            </div>
            <div ref="trendChartRef" class="trend-chart"></div>
          </div>
        </SpotlightCard>
      </div>
    </main>

    <!-- ============ 3. PAGE FOOTER ============ -->
    <footer class="page-footer">
      <span>面向复杂大田环境的玉米病害智能诊断系统 · 边缘端轻量模型与高精度注意机制自适应协同感知</span>
      <span class="footer-divider">|</span>
      <span>国家大田数字农业应用创新基地</span>
    </footer>
  </div>
</template>

<script setup>
import { ref, onMounted, onUnmounted, nextTick } from 'vue'
import axios from 'axios'
import * as echarts from 'echarts'
import ParticlesBg from '@/components/effects/ParticlesBg.vue'
import AuroraBg from '@/components/effects/AuroraBg.vue'
import SquaresBg from '@/components/effects/SquaresBg.vue'
import SpotlightCard from '@/components/effects/SpotlightCard.vue'
import ShinyText from '@/components/effects/ShinyText.vue'
import DecryptedText from '@/components/effects/DecryptedText.vue'
import CountUp from '@/components/effects/CountUp.vue'
import Magnet from '@/components/effects/Magnet.vue'
import TiltedCard from '@/components/effects/TiltedCard.vue'

// ── Clock ──────────────────────────────────────────────────────────────
const currentTime = ref('')
let clockTimer = null

// ── Backend & Model Status ─────────────────────────────────────────────
const backendOnline = ref(false)
const backendModel = ref('ResNet50-CBAM')
const inferenceSpeed = ref('14.2ms')

// ── Refs ───────────────────────────────────────────────────────────────
const fileInput = ref(null)
const messagesWrap = ref(null)
const chatTextarea = ref(null)
const trendChartRef = ref(null)
const radarChartRef = ref(null)
const distChartRef = ref(null)

// ── Upload & Sample state (删除所有内置假数据，完全从后端接口加载) ────
const isDragging = ref(false)
const previewUrl = ref('')
const currentSampleId = ref('')
const currentSample = ref(null)
const presetSamples = ref([])
const isDetecting = ref(false)
const isDetected = ref(false)
const showHeatmap = ref(false)

// ── Chat state ─────────────────────────────────────────────────────────
const inputText = ref('')
const aiTyping = ref(false)
const toolStatus = ref('')
const messages = ref([
  {
    role: 'ai',
    text: '您好！我是大田玉米叶部病害智能诊断与飞防专家助手 🌽（内核驱动：<strong>Agnes-3.0-Flash</strong>）。<br>系统与边缘端深度学习推理引擎（ResNet50 + CBAM 空间注意力机制）及大田微环境传感器实时协同。您可以点击上方真实大田样本或上传实拍图片进行病害诊断，也可以就病原菌防治、药剂配比及无人机作业参数随时向我咨询。'
  }
])

// ── Helpers ────────────────────────────────────────────────────────────
function formatTime(d) {
  return d.toTimeString().slice(0, 5)
}

function pushAiMessage(text) {
  messages.value.push({ role: 'ai', text })
  scrollChat(true)
}

function scrollChat(force = false) {
  nextTick(() => {
    if (!messagesWrap.value) return
    const el = messagesWrap.value
    const isNearBottom = el.scrollHeight - el.scrollTop - el.clientHeight < 120
    if (force || isNearBottom) {
      el.scrollTop = el.scrollHeight
    }
  })
}

function autoGrow(e) {
  const el = e.target
  el.style.height = 'auto'
  el.style.height = Math.min(el.scrollHeight, 120) + 'px'
}

// ── 1. 加载后端真实大田样本 ───────────────────────────────────────────
async function fetchPresetSamples() {
  try {
    // 接口：GET /screen/samples（后端 app/bigscreen_api.py 的 get_preset_samples）—— 4 类典型样本，用于样本直选与默认预览
    const res = await axios.get('/api/screen/samples')
    if (res.data?.data && res.data.data.length > 0) {
      presetSamples.value = res.data.data
      backendOnline.value = true
      if (!previewUrl.value) {
        selectPreset(presetSamples.value[0])
      }
    }
  } catch (err) {
    console.error('加载大田真实样本失败:', err)
  }
}

function selectPreset(sample) {
  currentSampleId.value = sample.id
  currentSample.value = {
    ...sample,
    boxes: []
  }
  previewUrl.value = sample.imgData
  isDetected.value = false
  showHeatmap.value = false
}

// ── 2. 用户本地图片上传 ────────────────────────────────────────────────
function onDrop(e) {
  isDragging.value = false
  const file = e.dataTransfer.files[0]
  if (file && file.type.startsWith('image/')) loadFile(file)
}

function onFileChange(e) {
  const file = e.target.files[0]
  if (file) loadFile(file)
}

function loadFile(file) {
  const reader = new FileReader()
  reader.onload = ev => {
    previewUrl.value = ev.target.result
    currentSampleId.value = 'custom'
    currentSample.value = {
      id: 'custom',
      name: file.name,
      scenario: '实景照片上传',
      diseaseName: '待执行 AI 诊断',
      pathogen: '检测中',
      severity: '待评估',
      damageRate: 0,
      confidence: 0,
      color: '#059669',
      prescription: '请点击下方按钮启动大田多尺度 AI 检测模型。',
      boxes: [],
      imgData: ev.target.result,
      gradcam_base64: ''
    }
    isDetected.value = false
    showHeatmap.value = false
  }
  reader.readAsDataURL(file)
}

function clearImage() {
  previewUrl.value = ''
  currentSampleId.value = ''
  currentSample.value = null
  isDetected.value = false
  showHeatmap.value = false
  if (fileInput.value) fileInput.value.value = ''
}

function toggleHeatmap() {
  showHeatmap.value = !showHeatmap.value
}

// ── 3. 调用后端真实模型推理诊断 ───────────────────────────────────────
async function runDetect() {
  if (!previewUrl.value || isDetecting.value) return
  isDetecting.value = true
  isDetected.value = false
  showHeatmap.value = false

  try {
    // 接口：POST /screen/predict（后端 app/bigscreen_api.py 的 predict_screen）—— 大屏综合诊断，返回病害/热力图/病斑框/处方
    const res = await axios.post('/api/screen/predict', {
      image_base64: previewUrl.value,
      filename: currentSample.value?.name || 'leaf.jpg',
      model: 'resnet50_cbam'
    })

    if (res.data?.data) {
      const data = res.data.data
      currentSample.value = {
        ...currentSample.value,
        diseaseName: data.diseaseName,
        class_name_en: data.class_name_en,
        class_name_cn: data.class_name_cn,
        pathogen: data.pathogen,
        severity: data.severity,
        damageRate: data.damageRate,
        confidence: data.confidence,
        color: data.color,
        prescription: data.prescription,
        droneParams: data.droneParams,
        boxes: data.boxes || [],
        gradcam_base64: data.gradcam_base64,
        probabilities: data.probabilities
      }
      isDetected.value = true
      backendOnline.value = true
      backendModel.value = data.model_used.includes('cbam') ? 'ResNet50-CBAM' : 'ResNet50'
      inferenceSpeed.value = data.inference_ms + 'ms'

      const boxDesc = data.boxes?.length ? ('，标注出 ' + data.boxes.length + ' 处典型病灶区域') : ''
      const text = '🎯 <strong>AI 诊断完成</strong>：检出主要病害为「<strong>' + data.diseaseName + '</strong>」' + boxDesc + '，置信度 <strong>' + data.confidence + '%</strong>，严重度：' + data.severity + '。<br>📋 处方：' + data.prescription
      pushAiMessage(text)
    }
  } catch (err) {
    console.error('模型推理诊断失败:', err)
    pushAiMessage('⚠️ 诊断请求异常，请检查后端模型服务状态。')
  } finally {
    isDetecting.value = false
  }
}

// ── 4. AI 专家智能问答对话 (真实 Vue3 响应式平滑打字流 + web_search) ────
const isAiStreaming = ref(false)

// 流式字符缓冲池与打字调度器
let typingBuffer = ''
let isNetworkDone = false
let typingIntervalTimer = null

function appendToBuffer(chunk) {
  typingBuffer += chunk
  if (!typingIntervalTimer) {
    runTypingEngine()
  }
}

function runTypingEngine() {
  if (typingIntervalTimer) return
  typingIntervalTimer = setInterval(() => {
    // 关键：直接通过 messages.value 访问当前的响应式 Proxy 对象
    const targetMsg = messages.value[messages.value.length - 1]
    if (!targetMsg || targetMsg.role !== 'ai') {
      clearInterval(typingIntervalTimer)
      typingIntervalTimer = null
      return
    }

    if (typingBuffer.length > 0) {
      // 自适应出字速率：缓冲区字多时稍快，字少时单字匀速打字
      let step = 1
      if (typingBuffer.length > 60) {
        step = 4
      } else if (typingBuffer.length > 25) {
        step = 2
      } else {
        step = 1
      }

      const slice = typingBuffer.slice(0, step)
      typingBuffer = typingBuffer.slice(step)
      // 触发 Vue 3 响应式更新，视图即刻逐字渲染
      targetMsg.text += slice
      scrollChat()
    } else if (isNetworkDone) {
      // 网络接收完毕且缓冲区字符已全部打在屏幕上
      clearInterval(typingIntervalTimer)
      typingIntervalTimer = null
      targetMsg.isStreaming = false
      isAiStreaming.value = false
      aiTyping.value = false
      toolStatus.value = ''
      scrollChat(true)
    }
  }, 22)
}

function flushTypingDirectly() {
  if (typingIntervalTimer) {
    clearInterval(typingIntervalTimer)
    typingIntervalTimer = null
  }
  const targetMsg = messages.value[messages.value.length - 1]
  if (targetMsg && targetMsg.role === 'ai') {
    if (typingBuffer) {
      targetMsg.text += typingBuffer
      typingBuffer = ''
    }
    targetMsg.isStreaming = false
  }
  isNetworkDone = true
  isAiStreaming.value = false
  aiTyping.value = false
  toolStatus.value = ''
  scrollChat(true)
}

function renderFormattedText(text) {
  if (!text) return ''
  // 保持包含特定预置 HTML 的固定文案完整性
  if (text.includes('<strong>Agnes-3.0-Flash</strong>') || text.includes('<strong>AI 诊断完成</strong>')) {
    return text
  }

  // 1. 转义基础 HTML 实体防御注入
  let html = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')

  // 2. 标题层级转换（使用 span 规避段落内非法嵌套 div 导致的 DOM 拆解重构）
  html = html
    .replace(/^### (.*$)/gim, '<span class="md-h3">$1</span>')
    .replace(/^## (.*$)/gim, '<span class="md-h2">$1</span>')
    .replace(/^# (.*$)/gim, '<span class="md-h1">$1</span>')

  // 3. 行内代码
  html = html.replace(/`([^`]+)`/g, '<code class="chat-inline-code">$1</code>')

  // 4. 成对粗体语法
  html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
  // 剥除末尾未闭合的单边 ** 标记，避免流式打字期间闪烁跳动
  html = html.replace(/\*\*$/, '')

  // 5. 列表与条目序号
  html = html.replace(/^[\*\-] (.*$)/gim, '<span class="md-li"><span class="md-bullet">•</span> $1</span>')
  html = html.replace(/^(\d+)\. (.*$)/gim, '<span class="md-li"><span class="md-num">$1.</span> $2</span>')

  // 6. 统一换行转义
  html = html.replace(/\n/g, '<br>')

  return html
}

async function sendMessage() {
  const txt = inputText.value.trim()
  if (!txt || aiTyping.value) return

  // 1. 用户提问入列并强制滚动至底部（不带时间）
  messages.value.push({ role: 'user', text: txt })
  inputText.value = ''
  if (chatTextarea.value) chatTextarea.value.style.height = 'auto'
  scrollChat(true)

  aiTyping.value = true
  isAiStreaming.value = false
  toolStatus.value = ''
  isNetworkDone = false
  typingBuffer = ''
  if (typingIntervalTimer) {
    clearInterval(typingIntervalTimer)
    typingIntervalTimer = null
  }

  // 2. 构造历史对话上下文
  const historyPayload = messages.value.slice(-6).map(m => ({
    role: m.role === 'ai' ? 'assistant' : 'user',
    content: (m.text || '').replace(/<[^>]+>/g, '')
  }))

  let hasCreatedAiMsg = false

  try {
    const response = await fetch('/api/screen/chat/stream', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'text/event-stream'
      },
      body: JSON.stringify({
        message: txt,
        context: (currentSample.value && isDetected.value) ? {
          diseaseName: currentSample.value.diseaseName,
          severity: currentSample.value.severity,
          damageRate: currentSample.value.damageRate,
          prescription: currentSample.value.prescription,
          climate: { temp: 28.4, humidity: 84.2 }
        } : {
          climate: { temp: 28.4, humidity: 84.2 }
        },
        history: historyPayload
      })
    })

    if (!response.ok) {
      throw new Error(`HTTP error ${response.status}`)
    }

    // 4. 标准 Fetch ReadableStream 流式消费
    const reader = response.body.getReader()
    const decoder = new TextDecoder('utf-8')
    let buffer = ''

    while (true) {
      const { value, done } = await reader.read()
      if (done) break

      buffer += decoder.decode(value, { stream: true })
      const lines = buffer.split('\n')
      buffer = lines.pop() || ''

      for (const line of lines) {
        const trimmed = line.trim()
        if (!trimmed || !trimmed.startsWith('data: ')) continue
        const jsonStr = trimmed.slice(6).trim()
        if (jsonStr === '[DONE]') break

        try {
          const evt = JSON.parse(jsonStr)

          // 4.1 触发了 web_search 联网检索工具调用
          if (evt.type === 'tool_call') {
            toolStatus.value = `🌐 正在调用 web_search 联网检索：「${evt.query}」...`
            scrollChat()
          } else if (evt.type === 'tool_result') {
            toolStatus.value = '🔍 联网检索完毕，大模型正在组织解答...'
            scrollChat()
          } else if (evt.type === 'delta') {
            // 4.2 收到流式文本增量：直接推入响应式打字池
            if (!hasCreatedAiMsg) {
              hasCreatedAiMsg = true
              isAiStreaming.value = true
              // 直接向 messages.value 压入响应式消息对象（不带时间）
              messages.value.push({
                role: 'ai',
                text: '',
                isStreaming: true,
                searchQuery: toolStatus.value ? toolStatus.value.replace(/.*「(.*)」.*/, '$1') : ''
              })
            }
            toolStatus.value = ''
            appendToBuffer(evt.content)
          } else if (evt.type === 'done') {
            toolStatus.value = ''
          }
        } catch (parseErr) {
          console.warn('解析流式 SSE 消息异常:', parseErr, jsonStr)
        }
      }
    }

    // 网络读取完毕，通知打字机平滑消费剩余字符
    isNetworkDone = true

    // 等待打字机打完剩余字符
    await new Promise(resolve => {
      const timer = setInterval(() => {
        if (!typingIntervalTimer && typingBuffer.length === 0) {
          clearInterval(timer)
          resolve()
        }
      }, 30)
    })

    const lastMsg = messages.value[messages.value.length - 1]
    if (!lastMsg || lastMsg.role !== 'ai' || !lastMsg.text) {
      if (!hasCreatedAiMsg) {
        messages.value.push({
          role: 'ai',
          text: '专家助手暂未给出解答。',
          isStreaming: false
        })
      }
    }
  } catch (err) {
    console.error('流式问答请求异常:', err)
    flushTypingDirectly()
    if (!hasCreatedAiMsg) {
      messages.value.push({
        role: 'ai',
        text: '⚠️ 专家助手服务响应超时或离线，请稍后重试。',
        isStreaming: false
      })
    }
  } finally {
    flushTypingDirectly()
    scrollChat(true)
  }
}

function askPreset(q) {
  inputText.value = q
  sendMessage()
}

// ── 5. 示范区大田遥测数据与可视化图表 (ECharts) ───────────────────────
let trendChart = null
let radarChart = null
let distChart = null

async function initCharts() {
  try {
    // 接口：GET /screen/telemetry（后端 app/bigscreen_api.py 的 get_telemetry）—— 微气候/病害分布/雷达，仅初始化拉一次
    const res = await axios.get('/api/screen/telemetry')
    const telemetry = res.data?.data
    if (!telemetry) return

    // 1. 24h 微气候折线图
    if (trendChartRef.value) {
      trendChart = echarts.init(trendChartRef.value)
      trendChart.setOption({
        grid: { top: 24, bottom: 24, left: 36, right: 16 },
        tooltip: { trigger: 'axis' },
        legend: {
          data: ['发病风险指数', '相对湿度(%)'],
          textStyle: { fontSize: 11, color: '#64748b' },
          top: 0,
          right: 0
        },
        xAxis: {
          type: 'category',
          data: telemetry.climate.hours,
          axisLine: { lineStyle: { color: '#cbd5e1' } },
          axisLabel: { color: '#64748b', fontSize: 11 },
          axisTick: { show: false }
        },
        yAxis: {
          type: 'value',
          min: 0,
          max: 100,
          splitLine: { lineStyle: { color: '#f1f5f9', type: 'dashed' } },
          axisLabel: { color: '#64748b', fontSize: 11 }
        },
        series: [
          {
            name: '发病风险指数',
            type: 'line',
            smooth: true,
            data: telemetry.climate.temperatures.map(t => Math.round(t * 2.5)),
            itemStyle: { color: '#ea580c' },
            lineStyle: { width: 2.5 },
            areaStyle: {
              color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                { offset: 0, color: 'rgba(234, 88, 12, 0.22)' },
                { offset: 1, color: 'rgba(234, 88, 12, 0.01)' }
              ])
            }
          },
          {
            name: '相对湿度(%)',
            type: 'line',
            smooth: true,
            data: telemetry.climate.humidities,
            itemStyle: { color: '#0284c7' },
            lineStyle: { width: 2, type: 'dashed' }
          }
        ]
      })
    }

    // 2. 抗逆鲁棒性六维雷达图
    if (radarChartRef.value) {
      radarChart = echarts.init(radarChartRef.value)
      radarChart.setOption({
        tooltip: { trigger: 'item' },
        radar: {
          indicator: telemetry.radar.map(r => ({ name: r.name, max: r.max })),
          center: ['50%', '52%'],
          radius: '65%',
          axisName: { color: '#475569', fontSize: 11 },
          splitLine: { lineStyle: { color: '#e2e8f0' } },
          splitArea: { show: false },
          axisLine: { lineStyle: { color: '#cbd5e1' } }
        },
        series: [
          {
            name: '抗逆鲁棒性评分',
            type: 'radar',
            data: [
              {
                value: telemetry.radar.map(r => r.value),
                name: 'ResNet50-CBAM 模型实测评分',
                symbol: 'circle',
                symbolSize: 4,
                itemStyle: { color: '#059669' },
                areaStyle: { color: 'rgba(5, 150, 105, 0.25)' }
              }
            ]
          }
        ]
      })
    }

    // 3. 病害频次分布南丁格尔玫瑰图
    if (distChartRef.value) {
      distChart = echarts.init(distChartRef.value)
      distChart.setOption({
        tooltip: { trigger: 'item', formatter: '{b}: {c}%' },
        legend: {
          orient: 'vertical',
          right: '2%',
          top: 'center',
          textStyle: { color: '#64748b', fontSize: 11 },
          itemWidth: 10,
          itemHeight: 10
        },
        series: [
          {
            name: '病害发生频次占比',
            type: 'pie',
            radius: ['28%', '75%'],
            center: ['40%', '50%'],
            roseType: 'radius',
            itemStyle: { borderRadius: 4, borderColor: '#ffffff', borderWidth: 1.5 },
            label: { show: false },
            data: telemetry.distribution.map(d => ({
              value: d.value,
              name: d.name,
              itemStyle: { color: d.color }
            }))
          }
        ]
      })
    }
  } catch (err) {
    console.error('加载遥测图表数据失败:', err)
  }
}

function handleResize() {
  trendChart && trendChart.resize()
  radarChart && radarChart.resize()
  distChart && distChart.resize()
}

// ── Lifecycle ──────────────────────────────────────────────────────────
onMounted(() => {
  const tick = () => {
    const now = new Date()
    currentTime.value = now.toLocaleString('zh-CN', {
      year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', second: '2-digit',
      hour12: false
    })
  }
  tick()
  clockTimer = setInterval(tick, 1000)

  // 1. 获取真实大田样本
  fetchPresetSamples()

  // 2. 初始化图表并拉取遥测数据
  nextTick(() => {
    initCharts()
  })

  window.addEventListener('resize', handleResize)
})

onUnmounted(() => {
  clearInterval(clockTimer)
  window.removeEventListener('resize', handleResize)
  trendChart && trendChart.dispose()
  radarChart && radarChart.dispose()
  distChart && distChart.dispose()
})
</script>

<style lang="scss" scoped>
/* ==========================================================================
   Modern Clean Light + React Bits Template System
   Palette: Slate-50 (#f8fafc) + Emerald (#059669) + Spotlight Pure White Cards
   ========================================================================== */

