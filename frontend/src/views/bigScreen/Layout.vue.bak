        </SpotlightCard>

        <!-- 7. Detection Results & Prescription Card (with React Bits Spotlight) -->
        <SpotlightCard className="result-spotlight-card" v-if="isDetected && currentSample" spotlightColor="rgba(217, 119, 6, 0.08)">
          <div class="card-head">
